<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>탄막 게임 - 모바일 지원</title>
    <style>
        body { 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            background-color: #1a1a1a; 
            margin: 0; 
            touch-action: none;
        }
        canvas { 
            background-color: #0d0d0d; 
            border: 2px solid #fff; 
            box-shadow: 0 0 15px rgba(255,255,255,0.2); 
            max-width: 100vw;
            max-height: 100vh;
        }
    </style>
</head>
<body>

<canvas id="gameCanvas" width="400" height="500"></canvas>

<script>
    const canvas = document.getElementById("gameCanvas");
    const ctx = canvas.getContext("2d");

    let player = { x: 200, y: 400, radius: 10, speed: 5 };
    let bullets = [];
    let scorePopups = [];
    let score = 0;
    let isGameOver = false;
    let keys = {};

    // 패링 버튼 영역 (모바일용)
    const parryBtn = { x: 300, y: 420, width: 85, height: 65 };

    let parry = {
        active: false,
        cooldown: false,
        radius: 40,
        duration: 15,
        cooldownTime: 70,
        timer: 0,
        cdTimer: 0,
        combo: 0,
        comboTimer: 0,
        maxComboTimer: 210
    };

    // 키보드 이벤트
    window.addEventListener("keydown", e => {
        keys[e.key] = true;
        if (isGameOver && e.key === " ") resetGame();
        if ((e.key === "Shift" || e.key === "z" || e.key === "Z") && !parry.cooldown && !isGameOver) {
            activateParry();
        }
    });
    window.addEventListener("keyup", e => keys[e.key] = false);

    // 터치 이벤트 (모바일)
    function handleTouch(e) {
        if (isGameOver) {
            resetGame();
            return;
        }

        let rect = canvas.getBoundingClientRect();
        let scaleX = canvas.width / rect.width;
        let scaleY = canvas.height / rect.height;

        for (let i = 0; i < e.touches.length; i++) {
            let touchX = (e.touches[i].clientX - rect.left) * scaleX;
            let touchY = (e.touches[i].clientY - rect.top) * scaleY;

            // 패링 버튼 터치 판정
            if (touchX >= parryBtn.x && touchX <= parryBtn.x + parryBtn.width &&
                touchY >= parryBtn.y && touchY <= parryBtn.y + parryBtn.height) {
                if (!parry.cooldown) activateParry();
            } else {
                // 손가락 위치로 플레이어 이동 (패링 버튼 외 영역 드래그)
                player.x = Math.max(player.radius, Math.min(canvas.width - player.radius, touchX));
                player.y = Math.max(player.radius, Math.min(canvas.height - player.radius, touchY - 30)); // 손가락 가림 방지 오프셋
            }
        }
    }

    canvas.addEventListener("touchstart", e => { e.preventDefault(); handleTouch(e); }, { passive: false });
    canvas.addEventListener("touchmove", e => { e.preventDefault(); handleTouch(e); }, { passive: false });

    function activateParry() {
        parry.active = true;
        parry.cooldown = true;
        parry.timer = parry.duration;
        parry.cdTimer = parry.cooldownTime;
    }

    function spawnBullet() {
        if (isGameOver) return;
        bullets.push({
            x: Math.random() * canvas.width,
            y: 0,
            radius: 4,
            speed: 3 + Math.random() * 4
        });
    }

    function resetGame() {
        player.x = 200;
        player.y = 400;
        bullets = [];
        scorePopups = [];
        score = 0;
        isGameOver = false;
        parry.active = false;
        parry.cooldown = false;
        parry.timer = 0;
        parry.cdTimer = 0;
        parry.combo = 0;
        parry.comboTimer = 0;
        update();
    }

    function update() {
        if (isGameOver) return;

        score++;

        if (parry.active) {
            parry.timer--;
            if (parry.timer <= 0) parry.active = false;
        }
        if (parry.cooldown) {
            parry.cdTimer--;
            if (parry.cdTimer <= 0) parry.cooldown = false;
        }

        if (parry.comboTimer > 0) {
            parry.comboTimer--;
            if (parry.comboTimer <= 0) parry.combo = 0;
        }

        // 키보드 이동
        if ((keys["ArrowLeft"] || keys["a"]) && player.x > player.radius) player.x -= player.speed;
        if ((keys["ArrowRight"] || keys["d"]) && player.x < canvas.width - player.radius) player.x += player.speed;
        if ((keys["ArrowUp"] || keys["w"]) && player.y > player.radius) player.y -= player.speed;
        if ((keys["ArrowDown"] || keys["s"]) && player.y < canvas.height - player.radius) player.y += player.speed;

        for (let i = bullets.length - 1; i >= 0; i--) {
            let b = bullets[i];
            b.y += b.speed;

            let dx = player.x - b.x;
            let dy = player.y - b.y;
            let dist = Math.sqrt(dx * dx + dy * dy);

            if (parry.active && dist < parry.radius + b.radius) {
                bullets.splice(i, 1);

                if (parry.combo < 5) parry.combo++;
                parry.comboTimer = parry.maxComboTimer;

                let pts = 200 * parry.combo;
                score += pts;

                scorePopups.push({
                    x: b.x,
                    y: b.y,
                    text: `+${pts} (${parry.combo} STACK!)`,
                    life: 30
                });
                continue;
            }

            if (dist < player.radius + b.radius) {
                isGameOver = true;
            }
        }

        bullets = bullets.filter(b => b.y < canvas.height);

        for (let i = scorePopups.length - 1; i >= 0; i--) {
            scorePopups[i].y -= 1;
            scorePopups[i].life--;
            if (scorePopups[i].life <= 0) scorePopups.splice(i, 1);
        }

        draw();
        if (!isGameOver) requestAnimationFrame(update);
        else drawGameOver();
    }

    function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // 패링 쉴드
        if (parry.active) {
            ctx.beginPath();
            ctx.arc(player.x, player.y, parry.radius, 0, Math.PI * 2);
            ctx.fillStyle = "rgba(180, 0, 255, 0.4)";
            ctx.fill();
            ctx.strokeStyle = "#d8b4fe";
            ctx.lineWidth = 2;
            ctx.stroke();
        }

        // 플레이어
        ctx.beginPath();
        ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);
        ctx.fillStyle = "#00ffff";
        ctx.fill();

        // 탄막
        ctx.fillStyle = "#ff4444";
        bullets.forEach(b => {
            ctx.beginPath();
            ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);
            ctx.fill();
        });

        // 팝업 텍스트
        scorePopups.forEach(p => {
            ctx.fillStyle = "#ffff00";
            ctx.font = "bold 13px sans-serif";
            ctx.fillText(p.text, p.x - 30, p.y);
        });

        // UI
        ctx.fillStyle = "#ffffff";
        ctx.font = "16px monospace";
        ctx.fillText("SCORE: " + score, 15, 30);

        if (parry.cooldown) {
            ctx.fillStyle = "#ff6666";
            ctx.fillText("PARRY: RECHARGING...", 15, 55);
        } else {
            ctx.fillStyle = "#00ffcc";
            ctx.fillText("PARRY: READY", 15, 55);
        }

        if (parry.combo > 0) {
            ctx.fillStyle = "#ff00ff";
            ctx.font = "bold 14px monospace";
            ctx.fillText(`COMBO: ${parry.combo}/5 STACK`, 15, 80);

            let barWidth = (parry.comboTimer / parry.maxComboTimer) * 100;
            ctx.fillStyle = "#ff00ff";
            ctx.fillRect(15, 88, barWidth, 4);
        }

        // 모바일 패링 버튼
        ctx.fillStyle = parry.cooldown ? "rgba(100, 100, 100, 0.5)" : "rgba(180, 0, 255, 0.7)";
        ctx.fillRect(parryBtn.x, parryBtn.y, parryBtn.width, parryBtn.height);
        ctx.strokeStyle = "#ffffff";
        ctx.lineWidth = 2;
        ctx.strokeRect(parryBtn.x, parryBtn.y, parryBtn.width, parryBtn.height);

        ctx.fillStyle = "#ffffff";
        ctx.font = "bold 14px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("PARRY", parryBtn.x + parryBtn.width / 2, parryBtn.y + 38);
        ctx.textAlign = "left";
    }

    function drawGameOver() {
        ctx.fillStyle = "rgba(0, 0, 0, 0.75)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.fillStyle = "#ff4444";
        ctx.font = "bold 28px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("GAME OVER", canvas.width / 2, 220);

        ctx.fillStyle = "#ffffff";
        ctx.font = "18px sans-serif";
        ctx.fillText("최종 점수: " + score, canvas.width / 2, 260);

        ctx.font = "14px sans-serif";
        ctx.fillStyle = "#aaa";
        ctx.fillText("화면을 터치하면 재시작합니다", canvas.width / 2, 300);
        ctx.textAlign = "left";
    }

    setInterval(spawnBullet, 100);
    update();
</script>
</body>
</html>
